{
  "name": "lifeos-portal",
  "version": "1.0.0",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1"
  },
  "jest": {
    "testEnvironment": "node",
    "projects": [
      {
        "displayName": "node",
        "testEnvironment": "node",
        "testMatch": [
          "**/__tests__/!(rpg)*.test.js"
        ]
      },
      {
        "displayName": "browser",
        "testEnvironment": "jsdom",
        "testMatch": [
          "**/__tests__/rpg*.test.js"
        ]
      }
    ],
    "collectCoverageFrom": [
      "lib/**/*.js",
      "assets/rpg_engine.js",
      "usage-bridge.js"
    ]
  }
}
